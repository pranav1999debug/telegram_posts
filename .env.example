# Telegram
TELEGRAM_BOT_TOKEN=replace_with_a_new_token_from_BotFather
# Numeric Telegram user IDs allowed to operate the bot, comma-separated.
ADMIN_USER_IDS=123456789
# Bot must be an administrator in these channels. Use @channelusername or numeric IDs.
TELEGRAM_FREE_CHANNEL_ID=@your_free_channel
TELEGRAM_PREMIUM_CHANNEL_ID=@your_premium_channel

# Supabase server-side credentials. Use the service-role secret, never a NEXT_PUBLIC key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_secret
SUPABASE_POSTS_TABLE=posts

# ImgChest personal access token
IMG_CHEST_TOKEN=replace_with_a_new_imgchest_token

# Catbox user hash (optional; leave blank for anonymous uploads)
CATBOX_USERHASH=replace_with_catbox_userhash

# Groq
GROQ_API_KEY=replace_with_a_new_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional behavior
MAX_MEDIA_ITEMS=20
